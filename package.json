    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reicon": "^1.2.4",
    "reicon-mcp": "^1.1.102",
    "tauri-plugin-secure-storage-api": "^1.5.0",
