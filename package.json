{
  "name": "app",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-ocr-assets.mjs && node scripts/sync-firebase-messaging-sw.mjs",
    "build": "vite build",
    "build:release": "npm run build && node scripts/prepare-android-release.mjs --require",
    "build:android": "node scripts/sync-ocr-assets.mjs && node scripts/sync-firebase-messaging-sw.mjs && node scripts/patch-android-theme.mjs && node scripts/strip-fcm.mjs && node scripts/check-local-storage.mjs && vite build --mode android && node scripts/check-web-bundle.mjs",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "postbuild": "node scripts/check-web-bundle.mjs && node scripts/check-local-storage.mjs && node scripts/prepare-android-release.mjs"
  },
  "dependencies": {
    "@alerix/m3-loading-indicator": "^1.0.5",
    "@choochmeque/tauri-plugin-notifications-api": "^0.5.0-rc.14",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "firebase": "^13.0.0",
    "hash-wasm": "^4.12.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.19",
    "reicon": "^1.2.5",
    "tauri-plugin-secure-storage-api": "^1.5.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.16",
    "fast-uri": "^3.1.8",
    "fflate": "^0.8.3",
    "serialize-javascript": "^7.1.2",
    "source-map-js": "^1.2.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "lucide-react": "^1.60.0",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
