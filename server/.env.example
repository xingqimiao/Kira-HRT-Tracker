# Copy to .env, fill in, and chmod 600.
#
# Generate every secret; never invent one:
#   echo "ENCRYPTION_KEY=$(openssl rand -base64 32)"
#   echo "SERVER_DEK_KEY=$(openssl rand -base64 48)"
#   echo "TURNSTILE_SECRET=$(openssl rand -base64 32)"   # only if you use Turnstile

NODE_ENV=production

# Postgres. Keep it on loopback or a unix socket.
DATABASE_URL=postgres://hrt:CHANGE_ME@127.0.0.1:5432/hrt

# Where the web app is served. The ONLY origin CORS allows, and where the OAuth
# callback sends the browser back to.
PUBLIC_ORIGIN=https://hrt.example.com

# This service's public origin, and the path prefix it is mounted under.
#
# The prefix is required when the host is shared: the comment service already owns
# /comments/* on api.example.com, and both services want /auth/x/callback. Two OAuth
# callbacks colliding does not fail loudly — it redeems one app's codes against the
# other's state. Leave BASE_PATH empty for a dedicated host.
API_ORIGIN=https://api.example.com
BASE_PATH=/hrt

# Loopback only: the reverse proxy is the sole ingress, so X-Forwarded-For cannot
# be spoofed.
PORT=8788
BIND_HOST=127.0.0.1

# Seals every record payload (AES-256-GCM, 32 bytes). Required — the server refuses
# to boot without it rather than writing a record in the clear.
#
# This is NOT end-to-end encryption: the server holds this key and decrypts on read,
# which is why it must be backed up separately from the database. Losing it makes
# every stored record unreadable, and it cannot be rotated — there is no re-wrap path.
ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_BYTES

# The key every account's server wrapper is wrapped under — the deployment's own copy
# of each account's data key. Required in production: the server refuses to boot without
# it, because without it no account is recoverable and a durable `hrt_` agent token
# cannot read anything. Back it up separately from the database, and treat it as
# permanent: re-wrapping every account under a new value needs each user's password.
SERVER_DEK_KEY=CHANGE_ME_GENERATE_48_BYTES

# Optional. Human verification (Cloudflare Turnstile) on the register form — that is
# the only route that calls it. Omit both to turn it off; set BOTH to enable — a
# secret with no hostname allowlist would accept a token minted on any site. The site
# key is public and lives in the web build; only the secret belongs here.
# TURNSTILE_SECRET=
# Comma-separated. Production must NOT include localhost/127.0.0.1.
# TURNSTILE_HOSTNAMES=hrt.example.com,example.com

# Idle lifetime of a sign-in, in minutes, renewed on every authenticated request.
# Default 30. Unrelated to agent tokens, which have no expiry unless one is asked for.
SESSION_TTL_MINUTES=10080

# Per-IP budgets. Raise these if a shared NAT (household, office) hits them.
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_WINDOW_MS=60000

# Optional. Omit a provider's pair and that button is simply not offered; set all of
# its variables to enable it. Both redirect URIs must equal the portal's registered
# callback byte for byte, prefix included.
#
# X (developer.x.com)
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=https://api.example.com/hrt/auth/x/callback
#
# Google (console.cloud.google.com) — the scope is `openid` alone, so no email or
# profile is requested and the account name comes from what the user binds here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.example.com/hrt/auth/google/callback
