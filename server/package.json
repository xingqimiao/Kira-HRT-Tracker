{
  "name": "hrt-server",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Multi-user, agent-native HRT tracking service. Application core + MCP adapters over the upstream PK engine.",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --define:import.meta.url=__filename --outfile=dist/index.cjs && node scripts/check-bundle.mjs",
    "start": "node dist/index.cjs",
    "dev": "node --env-file-if-exists=.env --experimental-transform-types --import ./resolve-hook.mjs --watch src/index.ts",
    "test": "node --experimental-transform-types --import ./resolve-hook.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "oci-common": "^2.145.0",
    "oci-keymanagement": "^2.145.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.2"
  }
}
